PORT=5001
# URL-encode special characters in the password (@ → %40, # → %23, etc.)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your-jwt-secret
CORS_ORIGIN=http://localhost:5173

# AWS Secrets Manager (operator apiSecret storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_OPERATOR_SECRET_PREFIX=gamotech/operators

# Session service proxy (admin panel → backend → api.dpbossking.com)
SESSION_API_URL=https://api.dpbossking.com
# Same secret as Session Service ADMIN_API_KEY (sent as X-Admin-Key header)
ADMIN_API_KEY=your-admin-key-here
